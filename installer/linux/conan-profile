# The AppImage's dependencies: GCC 14 from gcc-toolset-14 on AlmaLinux 9, as installer/linux/
# Containerfile sets up. The options come from conanfile.txt, as on Windows.
[settings]
os=Linux
arch=x86_64
build_type=Release
compiler=gcc
compiler.version=14
compiler.libcxx=libstdc++11
compiler.cppstd=23

[conf]
tools.cmake.cmaketoolchain:generator=Ninja
